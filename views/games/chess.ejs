<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link href="/public/css/output.css" rel="stylesheet" />
    <link href="/public/css/dashboard.css" rel="stylesheet" />
    <link
      rel="stylesheet"
      href="https://fontlibrary.org//face/chess"
      type="text/css"
    />
  </head>
  <body class="game-page">
    <main class="game-shell">
      <nav class="game-nav">
        <a class="flex items-center gap-2 font-black text-xl" href="/play">
          <span class="brand-mark">$</span>
          <span>Play</span>
        </a>
        <div class="dash-actions">
          <a class="dash-btn" href="/play">Lobby</a>
          <a class="dash-btn" href="/profile">Profile</a>
        </div>
      </nav>

      <section class="game-stage">
        <div class="board-panel">
          <div class="flex items-center justify-between gap-3">
            <div>
              <div class="hero-eyebrow">Rated chess</div>
              <h1 class="text-3xl md:text-5xl font-black tracking-tight"><%= title %></h1>
            </div>
            <span class="hero-badge">SERVER CLOCK</span>
          </div>

          <div class="clock-row">
            <div class="clock-card">
              <div class="clock-label">White</div>
              <div id="whiteClock" class="clock-value">00:00</div>
            </div>
            <div class="clock-card">
              <div class="clock-label">Black</div>
              <div id="blackClock" class="clock-value">00:00</div>
            </div>
          </div>

          <div class="chessboard shadow-lg overflow-hidden"></div>
        </div>

        <aside class="game-side-panel">
          <div>
            <div class="hero-eyebrow">Match flow</div>
            <h2 class="text-2xl font-black">Find your next rival.</h2>
            <p class="dash-muted mt-2">Choose a clock, ready up, and play from server-authoritative state.</p>
          </div>

          <div id="waiting" class="game-status hidden">Waiting for opponent...</div>

          <div id="readyPanel" class="game-status hidden">
            <div id="readyStatus">Match found</div>
            <div id="rematchStatus" class="dash-muted text-sm hidden"></div>
            <button id="readyButton" class="game-action w-full mt-3">Ready</button>
          </div>

          <a class="dash-btn text-center" href="/play">Back to lobby</a>
        </aside>
      </section>
    </main>

    <div id="timerModal" class="choice-modal">
      <div class="choice-card">
        <div class="hero-eyebrow">Choose pace</div>
        <h2 class="text-3xl font-black tracking-tight">Select a chess clock</h2>
        <div class="choice-grid">
          <button class="select-time" data-time="60">1 Min</button>
          <button class="select-time" data-time="300">5 Min</button>
          <button class="select-time" data-time="600">10 Min</button>
        </div>
      </div>
    </div>

    <script
      src="https://cdn.socket.io/4.8.1/socket.io.min.js"
      integrity="sha384-mkQ3/7FUtcGyoppY6bz/PORYoGqOl7/aSUMn2ymDOJcapfS6PHqxhRTMh1RR0Q6+"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"
      integrity="sha512-xRllwz2gdZciIB+AkEbeq+gVhX8VB8XsfqeFbUh+SzHlN96dEduwtTuVuc2u9EROlmW9+yhRlxjif66ORpsgVA=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    ></script>
    <script>
      window.PLAY_SOCKET_URL = <%- JSON.stringify(socketUrl || "") %>;
      window.PLAY_PLAYER_ID = <%- JSON.stringify(playerId || "") %>;
      window.PLAY_PLAYER_TOKEN = <%- JSON.stringify(playerToken || "") %>;
    </script>
    <script src="/public/js/games/chess.js"></script>
  </body>
</html>
