<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <link href="/public/css/output.css" rel="stylesheet">
  <link href="/public/css/dashboard.css" rel="stylesheet">
</head>
<body class="dashboard">
  <main class="dash-shell dash-grid">
    <section class="dash-topbar">
      <div class="player-chip">
        <% if (user?.avatar) { %>
          <img class="dash-avatar" src="<%= user.avatar %>" alt="">
        <% } else { %>
          <div class="dash-avatar"><%= (user?.displayName || "G").charAt(0).toUpperCase() %></div>
        <% } %>
        <div>
          <h1 class="dash-title"><%= user?.displayName || "Guest Player" %></h1>
          <div class="dash-subline">
            <span>Chess <%= user?.ratings?.chess || 1200 %></span>
            <span><%= friends.length %> friends</span>
          </div>
        </div>
      </div>
      <div class="dash-actions">
        <a class="dash-btn dash-btn-primary" href="/play">Play</a>
        <a class="dash-btn" href="/leaderboards">Leaders</a>
      </div>
    </section>

    <section class="metric-grid">
      <div class="metric-card">
        <div class="metric-value"><%= playerSummary.wins %></div>
        <div class="metric-label">Wins</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= playerSummary.losses %></div>
        <div class="metric-label">Losses</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= user?.ratings?.chess || 1200 %></div>
        <div class="metric-label">Chess rating</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= friends.length %></div>
        <div class="metric-label">Friends</div>
      </div>
    </section>

    <section class="dash-panel">
      <div class="section-head">
        <h2 class="section-title">Match History</h2>
      </div>
      <% if (playerSummary.recentMatches.length === 0) { %>
        <div class="empty-state">No matches yet.</div>
      <% } else { %>
        <div class="space-y-2">
          <% playerSummary.recentMatches.forEach((match) => { %>
            <div class="match-row">
              <div>
                <div class="font-semibold"><%= match.game %></div>
                <div class="dash-muted text-sm"><%= new Date(match.finishedAt).toLocaleString() %></div>
              </div>
              <div class="capitalize font-black"><%= match.outcome %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
