<!-- views/chess/index.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>

  <!-- Correctly link the CSS file -->
  <link href="/public/css/output.css" rel="stylesheet">
</head>

<body class="bg-gray-900 text-white flex flex-col items-center justify-center min-h-screen space-y-4">
  <% if (user) { %>
    <div>Signed in as <%= user.displayName %></div>
    <form method="post" action="/auth/logout">
      <button class="bg-gray-700 px-4 py-2 rounded-md" type="submit">Sign out</button>
    </form>
  <% } else { %>
    <a class="bg-blue-600 px-4 py-2 rounded-md" href="/auth/google">Sign in with Google</a>
    <a class="bg-black border border-white px-4 py-2 rounded-md" href="/auth/apple">Sign in with Apple</a>
  <% } %>
  <a href="game/chess">Play Chess</a>
  <a href="game/tic-tac-toe">Play Tic-Tac-Toe</a>
</body>
</html>
