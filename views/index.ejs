<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= seo?.title || title %></title>
  <%- include("partials/seo") %>
  <link href="/public/css/output.css" rel="stylesheet">
  <link href="/public/css/dashboard.css" rel="stylesheet">
</head>
<body class="dashboard">
  <main class="dash-shell dash-grid">
    <section class="dash-topbar">
      <div class="player-chip">
        <% if (user && user.avatar) { %>
          <img class="dash-avatar" src="<%= user.avatar %>" alt="">
        <% } else { %>
          <div class="dash-avatar"><%= (user?.displayName || "G").charAt(0).toUpperCase() %></div>
        <% } %>
        <div class="min-w-0">
          <h1 class="dash-title truncate"><%= user?.displayName || "Guest Player" %> — <%= user?.ratings?.chess || 1200 %></h1>
          <div class="dash-subline">
            <span class="status-online">Online</span>
            <span>Chess lobby ready</span>
          </div>
        </div>
      </div>

      <div class="dash-actions">
        <a class="dash-btn dash-btn-primary" href="/play">Play</a>
        <a class="dash-btn" href="/profile">Profile</a>
        <a class="dash-btn" href="/leaderboards">Leaders</a>
        <% if (user) { %>
          <form method="post" action="/auth/logout">
            <button class="dash-btn" type="submit">Sign out</button>
          </form>
        <% } else { %>
          <a class="dash-btn dash-btn-blue" href="/auth/google">Sign in with Google</a>
        <% } %>
      </div>
    </section>

    <section class="metric-grid">
      <div class="metric-card">
        <div class="metric-value"><%= playerSummary.wins %></div>
        <div class="metric-label">Wins</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= playerSummary.losses %></div>
        <div class="metric-label">Losses</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= user?.ratings?.chess || 1200 %></div>
        <div class="metric-label">Chess rating</div>
      </div>
      <div class="metric-card">
        <div class="metric-value"><%= playerSummary.recentMatches.length %></div>
        <div class="metric-label">Recent matches</div>
      </div>
    </section>

    <section class="game-grid">
      <article class="game-card" data-category="board" data-game-id="chess">
        <div class="game-card-inner">
          <div>
            <div class="card-kicker">Rated / 1v1</div>
            <h2 class="text-2xl font-black">Chess</h2>
          </div>
          <div class="dash-muted">Server-authoritative games with clocks, Elo, history, and rematches.</div>
          <a class="dash-btn dash-btn-primary text-center" href="/play">Enter Lobby</a>
        </div>
      </article>

      <article class="game-card" data-category="quick" data-game-id="tictactoe">
        <div class="game-card-inner">
          <div>
            <div class="card-kicker">Casual / quick</div>
            <h2 class="text-2xl font-black">Tic-Tac-Toe</h2>
          </div>
          <div class="dash-muted">A fast second game plugged into the same matchmaking system.</div>
          <a class="dash-btn text-center" href="/game/tic-tac-toe">Play Tic-Tac-Toe</a>
        </div>
      </article>
    </section>

    <section class="dash-panel">
      <div class="section-head">
        <h2 class="section-title">Recent Matches</h2>
      </div>
      <% if (playerSummary.recentMatches.length === 0) { %>
        <div class="empty-state">No matches yet.</div>
      <% } else { %>
        <div class="space-y-2">
          <% playerSummary.recentMatches.forEach((match) => { %>
            <div class="match-row">
              <div>
                <div class="font-semibold"><%= match.game %></div>
                <div class="dash-muted text-sm"><%= new Date(match.finishedAt).toLocaleString() %></div>
              </div>
              <div class="capitalize font-black"><%= match.outcome %></div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
